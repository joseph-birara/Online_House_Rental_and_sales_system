# Backend API (must be listed in the server CLIENT_ORIGIN allowlist)
# Local: http://localhost:4000
# Production: https://house-rental.onrender.com
REACT_APP_API_URL=http://localhost:4000

# Cloudinary unsigned upload (public at build time — restrict the preset in Cloudinary)
REACT_APP_CLOUD_NAME=
REACT_APP_UPLOAD_PRESET=
